# This is a standard .gitignore file for Unity projects
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# MemoryCaptures can get large and usually aren't tracked
/[Mm]emoryCaptures/

# Visual Studio cache/options directories
.vs/
.idea/
*.suo
*.user
*.userprefs
*.sln

# Unity Generated
/*.unityproj
/*.csproj
/*.sln
/*.pidb
/*.suo
/*.user
/*.userprefs
/*.unitypackage

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
